SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=FloraGuard-PlantHealth-AI
APP_VERSION=2.4.0
DATABASE_URL=postgresql://floraguard_user:db_password_here@postgres:5432/floraguard_db
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_TIMEOUT=30
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
SECRET_KEY=replace_with_a_secure_256bit_random_secret_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
MODEL_STORAGE_PATH=./ml_models/checkpoints
INFERENCE_DEVICE=cpu
BATCH_INFERENCE_MAX_SIZE=32
HEATMAP_RESOLUTION=224
CONFIDENCE_THRESHOLD=0.75
WEATHER_API_KEY=your_openweather_or_agromet_api_key
SMS_GATEWAY_API_KEY=your_sms_gateway_key
IOT_MQTT_BROKER_HOST=mqtt.agrisense.local
IOT_MQTT_BROKER_PORT=1883
